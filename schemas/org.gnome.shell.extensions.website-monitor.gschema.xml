<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.website-monitor"
          path="/org/gnome/shell/extensions/website-monitor/">
    <key name="monitor-enabled" type="b">
      <default>true</default>
      <summary>Enable website monitoring</summary>
    </key>
    <key name="website-url" type="s">
      <default>'https://example.com'</default>
      <summary>Website URL</summary>
    </key>
    <key name="slow-threshold-enabled" type="b">
      <default>true</default>
      <summary>Enable slow response detection</summary>
    </key>
    <key name="slow-threshold-ms" type="u">
      <default>2000</default>
      <range min="100" max="60000"/>
      <summary>Slow response threshold in milliseconds</summary>
    </key>
    <key name="check-interval" type="u">
      <default>60</default>
      <range min="5" max="86400"/>
      <summary>Seconds between checks</summary>
    </key>
    <key name="failure-threshold" type="u">
      <default>3</default>
      <range min="1" max="100"/>
      <summary>Consecutive failed checks before alerting</summary>
    </key>
    <key name="history-size" type="u">
      <default>10</default>
      <range min="1" max="100"/>
      <summary>Number of recent checks to display</summary>
    </key>
    <key name="history-popup-side" type="s">
      <default>'left'</default>
      <choices>
        <choice value="left"/>
        <choice value="right"/>
        <choice value="auto"/>
      </choices>
      <summary>Side on which the recent-checks popup opens</summary>
    </key>
    <key name="request-timeout" type="u">
      <default>15</default>
      <range min="1" max="120"/>
      <summary>HTTP request timeout in seconds</summary>
    </key>
    <key name="alert-sound-uri" type="s">
      <default>''</default>
      <summary>URI of the custom MP3 alert sound</summary>
      <description>Empty uses the default desktop warning sound.</description>
    </key>
    <key name="sound-alert-enabled" type="b">
      <default>true</default>
      <summary>Enable audible alerts</summary>
    </key>
    <key name="test-alert-request" type="u">
      <default>0</default>
      <summary>Alert test request counter</summary>
      <description>Changing this value asks the running extension to show a test alert.</description>
    </key>
    <key name="email-enabled" type="b">
      <default>false</default>
      <summary>Send an email when an outage reaches the alert threshold</summary>
    </key>
    <key name="smtp-host" type="s">
      <default>''</default>
      <summary>SMTP server hostname</summary>
    </key>
    <key name="smtp-port" type="u">
      <default>587</default>
      <range min="1" max="65535"/>
      <summary>SMTP server port</summary>
    </key>
    <key name="smtp-security" type="s">
      <default>'starttls'</default>
      <choices>
        <choice value="tls"/>
        <choice value="starttls"/>
        <choice value="none"/>
      </choices>
      <summary>SMTP connection security</summary>
    </key>
    <key name="smtp-username" type="s">
      <default>''</default>
      <summary>SMTP username</summary>
    </key>
    <key name="smtp-password" type="s">
      <default>''</default>
      <summary>SMTP password</summary>
    </key>
    <key name="email-from" type="s">
      <default>''</default>
      <summary>Sender email address</summary>
    </key>
    <key name="email-recipients" type="s">
      <default>''</default>
      <summary>Comma-separated recipient email addresses</summary>
    </key>
    <key name="test-email-request" type="u">
      <default>0</default>
      <summary>Test email request counter</summary>
      <description>Changing this value asks the running extension to send a test email.</description>
    </key>
  </schema>
</schemalist>
